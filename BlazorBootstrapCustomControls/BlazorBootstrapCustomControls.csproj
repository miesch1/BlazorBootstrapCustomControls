<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>BlazorBootstrapCustomControls</PackageId>
    <Authors>miesch</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://blazor.codingmatter.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miesch1/BlazorBootstrapCustomControls</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Razor Class Library providing Bootstrap 5-compatible single- and multi-select dropdown components for Blazor.</Description>
    <PackageTags>blazor;bootstrap;components;dropdown;select</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <!--
    Single source of truth: wwwroot/js|css. Checked-in docs mirrors (for static preview / consistency)
    are overwritten on every library build so they cannot drift from wwwroot.
  -->
  <Target Name="SyncStaticWebAssetsToDocsMirrors"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\docs')">
    <PropertyGroup>
      <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</_RepoRoot>
      <_JsSrc>$(MSBuildThisFileDirectory)wwwroot\js\bootstrap-select.js</_JsSrc>
      <_CssSrc>$(MSBuildThisFileDirectory)wwwroot\css\bootstrap-select.css</_CssSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(_JsSrc)" DestinationFolder="$(_RepoRoot)docs\_content\BlazorBootstrapCustomControls\js" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_JsSrc)" DestinationFolder="$(_RepoRoot)docs\wwwroot\_content\BlazorBootstrapCustomControls\js" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_CssSrc)" DestinationFolder="$(_RepoRoot)docs\_content\BlazorBootstrapCustomControls\css" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_CssSrc)" DestinationFolder="$(_RepoRoot)docs\wwwroot\_content\BlazorBootstrapCustomControls\css" SkipUnchangedFiles="true" />
  </Target>

</Project>
