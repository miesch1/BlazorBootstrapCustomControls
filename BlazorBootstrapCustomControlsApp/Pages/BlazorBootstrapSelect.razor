@page "/test-blazorbootstrap"
@using Microsoft.AspNetCore.Components.Web
@using BlazorBootstrapCustomControls.Components.Shared

<PageTitle>Custom Blazor Bootstrap Select Controls Test</PageTitle>

<h3>Custom Blazor Bootstrap Select Components</h3>
<p class="text-muted">Showcasing BlazorBootstrapSelectSingle and BlazorBootstrapSelectMulti from the BlazorBootstrapCustomControls library.</p>
<p class="text-muted small">These controls provide input-like appearance, full data binding with @@bind-Value, and comprehensive keyboard navigation per the README specification.</p>

<h4 class="mt-4">Single Select (BlazorBootstrapSelectSingle)</h4>
<p class="text-muted small">Input-like single-select control with @@bind-Value support and keyboard navigation.</p>

<p class="text-muted small">Many options below exercise the dropdown scrollbar; drag the thumb — the list should stay open (see <a href="https://github.com/miesch1/BlazorBootstrapCustomControls/issues/3">issue #3</a>).</p>
<BlazorBootstrapSelectSingleString Label="Single Sport (Custom, DropdownMatchInputWidth=true — many options / scrollbar)"
                                   Data="@SportsMany"
                                   PlaceholderText="-- Select Sport --"
                                   DropdownMatchInputWidth="true"
                                   @bind-Value="@selectedSportCustom" />

<p class="mt-2">Selected: @selectedSportCustom</p>

<BlazorBootstrapSelectSingleString Label="Single Sport (No Deselect)"
                                   Data="@Sports"
                                   PlaceholderText="-- Select Sport --"
                                   AllowDeselect="false"
                                   ShowClearButton="true"
                                   @bind-Value="@selectedSportNoDeselect" />

<p class="mt-2">Selected: @selectedSportNoDeselect</p>

<BlazorBootstrapSelectSingleString Label="Single Sport (Disabled)"
                                   Data="@Sports"
                                   PlaceholderText="-- Select Sport --"
                                   Disabled="true"
                                   Value="@selectedSportDisabled" />

<p class="mt-2">Selected: @selectedSportDisabled</p>

<BlazorBootstrapSelectSingleString Label="Single Sport (Custom Width)"
                                   Data="@Sports"
                                   PlaceholderText="-- Select Sport --"
                                   Width="400px"
                                   @bind-Value="@selectedSportCustomWidth" />

<p class="mt-2">Selected: @selectedSportCustomWidth</p>

<BlazorBootstrapSelectSingle TItem="SportOption" TValue="string"
                             Label="Single Sport (Icon convenience API — Bootstrap Icons CssClass)"
                             Data="@SportOptions"
                             TextField="s => s.Name"
                             ValueField="s => s.Id"
                             PlaceholderText="-- Select Sport --"
                             IconContent="s => s.IconClass"
                             IconRenderMode="SelectIconRenderMode.CssClass"
                             IconPlacement="SelectIconPlacement.Start"
                             SemanticField="s => s.Semantic"
                             SemanticTextField="s => s.SemanticLabel"
                             @bind-Value="@selectedSportConvenience" />

<p class="text-muted small">Requires Bootstrap Icons CSS (e.g. <code>&lt;link href=&quot;...bootstrap-icons...&quot;&gt;</code>).</p>
<p class="mt-2">Selected: @selectedSportConvenience</p>

<BlazorBootstrapSelectSingleString Label="Single Sport (Validation Demo)"
                                   Data="@Sports"
                                   PlaceholderText="-- Select Sport --"
                                   Class="@(singleSportInvalid ? "is-invalid" : null)"
                                   Value="@singleSportValidation"
                                   ValueChanged="@OnSingleSportValidationChanged" />

@if (singleSportInvalid)
{
  <div class="invalid-feedback d-block">
    Please select a sport.
  </div>
}

<p class="text-muted small mt-2">Invalid + auto-expand (no clear): select a long option and confirm wrapped text does not overlap the arrow/validation icon.</p>
<BlazorBootstrapSelectSingleString Label="Single Sport (Invalid + Auto-Expand, no clear — visual test)"
                                   Data="@Sports"
                                   PlaceholderText="-- Select Sport --"
                                   Width="210px"
                                   IsInvalid="true"
                                   AutoExpandVertically="true"
                                   ShowClearButton="false"
                                   @bind-Value="@selectedSportInvalidAutoExpand" />

<p class="mt-2">Selected: @selectedSportInvalidAutoExpand</p>

<h4 class="mt-4">Multi Select (BlazorBootstrapSelectMulti)</h4>
<p class="text-muted small">Input-like multi-select control with @@bind-Value support, check-marks for selected items, and dropdown stays open for multiple selections.</p>

<!-- Generic TItem/TValue example (custom type + string value). -->
<BlazorBootstrapSelectMulti TItem="SportOption" TValue="string"
                             Label="Multiple Sports (Custom)"
                             Data="@SportOptions"
                             TextField="s => s.Name"
                             ValueField="s => s.Id"
                             PlaceholderText="-- Select Sports --"
                             @bind-Value="@selectedSportsCustom" />

<p class="mt-2">Selected: @string.Join(", ", selectedSportsCustom ?? Array.Empty<string>())</p>

<p class="text-muted small">Settings for <strong>Multiple Sports (Icon + Pill template)</strong>.</p>
<div class="form-check mb-2">
  <input class="form-check-input" type="checkbox" id="iconPillAutoExpandToggle" @bind="@iconPillAutoExpandEnabled" />
  <label class="form-check-label" for="iconPillAutoExpandToggle">
    Auto-expand input (icon + pill example)
  </label>
</div>
<div class="form-check mb-2">
  <input class="form-check-input" type="checkbox" id="semanticPillAlignRightToggle" @bind="@semanticPillAlignRight" />
  <label class="form-check-label" for="semanticPillAlignRightToggle">
    Align semantic pills to the right (icon + pill example rows)
  </label>
</div>

<BlazorBootstrapSelectMulti TItem="SportOption" TValue="string"
                            Label="Multiple Sports (Icon + Pill template)"
                            Data="@SportOptions"
                            TextField="s => s.Name"
                            ValueField="s => s.Id"
                            PlaceholderText="-- Select Sports --"
                            AutoExpandVertically="@iconPillAutoExpandEnabled"
                            SemanticField="s => s.Semantic"
                            SemanticTextField="s => s.SemanticLabel"
                            @bind-Value="@selectedSportsWithTemplate"
                            ItemTemplate="@SportItemTemplate"
                            SelectedValueTemplate="@SportSelectedTemplate" />

<p class="mt-2">Selected: @string.Join(", ", selectedSportsWithTemplate ?? Array.Empty<string>())</p>

<BlazorBootstrapSelectMultiString Label="Multiple Sports (Disabled)"
                                  Data="@Sports"
                                  PlaceholderText="-- Select Sports --"
                                  Disabled="true"
                                  Value="@selectedSportsDisabled" />

<p class="mt-2">Selected: @string.Join(", ", selectedSportsDisabled ?? Array.Empty<string>())</p>

<BlazorBootstrapSelectMultiString Label="Multiple Sports (No Clear Button)"
                                  Data="@Sports"
                                  PlaceholderText="-- Select Sports --"
                                  ShowClearButton="false"
                                  @bind-Value="@selectedSportsNoClear" />

<p class="mt-2">Selected: @string.Join(", ", selectedSportsNoClear ?? Array.Empty<string>())</p>

<p class="text-muted small">Ellipsis ("...") when content exceeds width.</p>

<div class="form-check mb-2">
  <input class="form-check-input" type="checkbox" id="plainAutoExpandToggle" @bind="@autoExpandEnabled" />
  <label class="form-check-label" for="plainAutoExpandToggle">
    Auto-expand input (plain MultiString example below)
  </label>
</div>

<BlazorBootstrapSelectMultiString Label="Multiple Sports (Custom Width + Auto-Expand)"
                                  Data="@Sports"
                                  PlaceholderText="-- Select Sports --"
                                  Width="400px"
                                  AutoExpandVertically="@autoExpandEnabled"
                                  @bind-Value="@selectedSportsAutoExpand" />

<p class="mt-2">Selected: @string.Join(", ", selectedSportsAutoExpand ?? Array.Empty<string>())</p>
<p class="text-muted small">AutoExpandVertically="@autoExpandEnabled": input grows vertically when text wraps.</p>

<hr />

<h4 class="mt-4">Key Features</h4>
<div class="alert alert-success">
  <h5>Custom Blazor Bootstrap Select Controls Advantages:</h5>
  <ul class="mb-0">
    <li><strong>Input-like Appearance:</strong> Matches native Bootstrap form-control styling, not button-style</li>
    <li><strong>Data Binding:</strong> Full @@bind-Value support with type-safe EventCallback</li>
    <li><strong>Focus Ring:</strong> Remains on input while interacting with dropdown list</li>
    <li><strong>Keyboard Navigation:</strong> Down/Right/Enter to open, Arrow keys to navigate, Enter to select, Escape/Tab to close</li>
    <li><strong>Placeholder Support:</strong> Built-in placeholder text when no value selected</li>
    <li><strong>Clear Button:</strong> Optional clear button (×) for easy deselection</li>
    <li><strong>Multi-select:</strong> Dropdown stays open, selected items show check-marks, comma-separated display</li>
    <li><strong>Overflow:</strong> Ellipsis ("...") by default when text exceeds width; optional <code>AutoExpandVertically</code> to wrap and grow</li>
    <li><strong>Validation:</strong> Supports EditForm and ValidationMessage components</li>
    <li><strong>Type Safety:</strong> Generic TItem with strongly-typed TextField and ValueField</li>
    <li><strong>Accessibility:</strong> Full ARIA support (role, aria-expanded, aria-selected, etc.)</li>
  </ul>
</div>

@code {
  public class SportOption
  {
    public string Id { get; set; } = string.Empty;
    public string Name { get; set; } = string.Empty;
    /// <summary>Glyph/emoji for template-based multi-select example.</summary>
    public string Icon { get; set; } = "";
    /// <summary>Bootstrap Icons class list for single-select convenience API example (e.g. <c>bi bi-trophy</c>).</summary>
    public string IconClass { get; set; } = "";
    public SelectSemantic Semantic { get; set; } = SelectSemantic.None;
    public string? SemanticLabel { get; set; }
  }

  private List<string> Sports = new()
  {
    "Cross-Country, Track & Field",
    "Cross-Country",
    "Swimming",
    "Track & Field",
    "Basketball",
    "Soccer",
    "Tennis"
  };

  /// <summary>Enough entries to exceed .bs-select-dropdown max-height (~17.5rem) for scrollbar drag testing (issue #3).</summary>
  private static readonly List<string> SportsMany = new()
  {
    "Archery", "Badminton", "Baseball", "Basketball", "Bowling", "Boxing", "Cheerleading", "Cricket",
    "Cross-Country", "Cycling", "Diving", "Equestrian", "Fencing", "Field Hockey", "Football", "Golf",
    "Gymnastics", "Ice Hockey", "Lacrosse", "Martial Arts", "Rowing", "Rugby", "Sailing", "Skateboarding",
    "Skiing", "Soccer", "Softball", "Swimming", "Table Tennis", "Tennis", "Track & Field", "Volleyball",
    "Water Polo", "Weightlifting", "Wrestling"
  };

  private List<SportOption> SportOptions = new()
  {
    new() { Id = "1", Name = "Cross-Country, Track & Field", Icon = "🏃", IconClass = "bi bi-lightning-charge", Semantic = SelectSemantic.Warning, SemanticLabel = "Intense" },
    new() { Id = "2", Name = "Cross-Country", Icon = "🏃", IconClass = "bi bi-stopwatch", Semantic = SelectSemantic.Pending, SemanticLabel = "Seasonal" },
    new() { Id = "3", Name = "Swimming", Icon = "🏊", IconClass = "bi bi-water", Semantic = SelectSemantic.Info, SemanticLabel = "Pool" },
    new() { Id = "4", Name = "Track & Field", Icon = "🥇", IconClass = "bi bi-trophy", Semantic = SelectSemantic.Success, SemanticLabel = "Popular" },
    new() { Id = "5", Name = "Basketball", Icon = "🏀", IconClass = "bi bi-dribbble", Semantic = SelectSemantic.Success, SemanticLabel = "Team" },
    new() { Id = "6", Name = "Soccer", Icon = "⚽", IconClass = "bi bi-circle", Semantic = SelectSemantic.Danger, SemanticLabel = "Limited slots" },
    new() { Id = "7", Name = "Tennis", Icon = "🎾", IconClass = "bi bi-activity", Semantic = SelectSemantic.None, SemanticLabel = "Unrated" }
  };

  // Single select values
  private string? selectedSportCustom;
  private string? selectedSportNoDeselect;
  private string? selectedSportDisabled = "Swimming"; // Pre-selected for disabled example
  private string? selectedSportCustomWidth;
  private string? selectedSportConvenience = "4";
  private string? singleSportValidation;
  private bool singleSportInvalid = true;
  private string? selectedSportInvalidAutoExpand;

  // Multi select values
  private string[]? selectedSportsCustom = Array.Empty<string>();
  private string[]? selectedSportsDisabled = new[] { "Swimming", "Basketball" }; // Pre-selected for disabled example
  private string[]? selectedSportsNoClear = Array.Empty<string>();
  private string[]? selectedSportsWithTemplate = new[] { "2", "6", "7" };
  private string[]? selectedSportsCustomWidth = Array.Empty<string>();
  private string[]? selectedSportsAutoExpand = Array.Empty<string>();
  private bool autoExpandEnabled = true; // Default to true to show auto-expand behavior initially
  private bool iconPillAutoExpandEnabled = true;

  private bool semanticPillAlignRight = true;

  private static string GetSemanticChipClass(SelectSemantic semantic) => semantic switch
  {
    SelectSemantic.None => "status-chip status-chip-none",
    SelectSemantic.Pending => "status-chip status-chip-pending",
    SelectSemantic.Info => "status-chip status-chip-info",
    SelectSemantic.Success => "status-chip status-chip-success",
    SelectSemantic.Warning => "status-chip status-chip-warning",
    SelectSemantic.Danger => "status-chip status-chip-danger",
    _ => "status-chip status-chip-none"
  };

  private RenderFragment<SelectItemContext<SportOption, string>> SportItemTemplate => ctx =>
  {
    var showPill = !string.IsNullOrWhiteSpace(ctx.SemanticText);
    var pillClass = GetSemanticChipClass(ctx.Semantic);

    if (semanticPillAlignRight)
    {
      return @<div class="d-flex align-items-center gap-2">
        <span class="d-flex align-items-center gap-2">
          <span aria-hidden="true">@ctx.Item.Icon</span>
          <span>@ctx.Text</span>
        </span>
        @if (showPill)
        {
          <span class="@pillClass ms-auto">@ctx.SemanticText</span>
        }
      </div>;
    }

    // Left-aligned pill right after text.
    return @<div class="d-flex align-items-center gap-2">
      <span aria-hidden="true">@ctx.Item.Icon</span>
      <span>@ctx.Text</span>
      @if (showPill)
      {
        <span class="@pillClass">@ctx.SemanticText</span>
      }
    </div>;
  };

  private static RenderFragment<SelectItemContext<SportOption, string>> SportSelectedTemplate => ctx => @<span class="d-inline-flex align-items-center gap-2">
    <span aria-hidden="true">@ctx.Item.Icon</span>
    <span>@ctx.Text</span>
    @if (!string.IsNullOrWhiteSpace(ctx.SemanticText))
    {
      <span class="@GetSemanticChipClass(ctx.Semantic)">@ctx.SemanticText</span>
    }
  </span>;

  private Task OnSingleSportValidationChanged(string? value)
  {
    singleSportValidation = value;
    singleSportInvalid = string.IsNullOrEmpty(value);
    return Task.CompletedTask;
  }
}
