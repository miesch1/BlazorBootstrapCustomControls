@* Convenience wrapper for string-only data (no selectors needed).
   Example:
   <BlazorBootstrapSelectSingleString Data="@colors" @bind-Value="@selectedColor" />
*@

<BlazorBootstrapSelectSingle TItem="string" TValue="string"
                             Label="@Label"
                             Data="@Data"
                             TextField="s => s"
                             ValueField="s => s"
                             PlaceholderText="@PlaceholderText"
                             Width="@Width"
                             Class="@Class"
                             IsInvalid="@IsInvalid"
                             InputAttributes="@InputAttributes"
                             Disabled="@Disabled"
                             ShowClearButton="@ShowClearButton"
                             AutoExpandVertically="@AutoExpandVertically"
                             DropdownMatchInputWidth="@DropdownMatchInputWidth"
                             AllowDeselect="@AllowDeselect"
                             ItemTemplate="@ItemTemplate"
                             SelectedValueTemplate="@SelectedValueTemplate"
                             IconContent="@IconContent"
                             IconAriaLabelField="@IconAriaLabelField"
                             IconRenderMode="@IconRenderMode"
                             IconPlacement="@IconPlacement"
                             ShowIconInSelectedValue="@ShowIconInSelectedValue"
                             ShowSemanticPillInSelectedValue="@ShowSemanticPillInSelectedValue"
                             SemanticField="@SemanticField"
                             SemanticTextField="@SemanticTextField"
                             Value="@Value"
                             ValueChanged="@ValueChanged"
                             ValidationMessage="@ValidationMessage" />

@code {
  [Parameter] public IEnumerable<string>? Data { get; set; }
  [Parameter] public string? Label { get; set; }
  [Parameter] public string? PlaceholderText { get; set; }
  [Parameter] public string? Width { get; set; }
  [Parameter] public string? Class { get; set; }
  [Parameter] public bool IsInvalid { get; set; }
  [Parameter] public IDictionary<string, object>? InputAttributes { get; set; }
  [Parameter] public bool Disabled { get; set; }
  [Parameter] public bool ShowClearButton { get; set; } = true;
  [Parameter] public bool AutoExpandVertically { get; set; }
  [Parameter] public bool DropdownMatchInputWidth { get; set; }
  [Parameter] public bool AllowDeselect { get; set; } = true;
  [Parameter] public RenderFragment<SelectItemContext<string, string>>? ItemTemplate { get; set; }
  [Parameter] public RenderFragment<SelectItemContext<string, string>>? SelectedValueTemplate { get; set; }
  [Parameter] public Func<string, string?>? IconContent { get; set; }
  [Parameter] public Func<string, string?>? IconAriaLabelField { get; set; }
  [Parameter] public SelectIconRenderMode IconRenderMode { get; set; } = SelectIconRenderMode.CssClass;
  [Parameter] public SelectIconPlacement IconPlacement { get; set; } = SelectIconPlacement.Start;
  [Parameter] public bool ShowIconInSelectedValue { get; set; } = true;
  [Parameter] public bool ShowSemanticPillInSelectedValue { get; set; } = true;
  [Parameter] public Func<string, SelectSemantic>? SemanticField { get; set; }
  [Parameter] public Func<string, string?>? SemanticTextField { get; set; }
  [Parameter] public string? Value { get; set; }

  /// <summary>Invoked with the new string or <c>null</c> when cleared — never <see cref="ChangeEventArgs"/>.</summary>
  [Parameter] public EventCallback<string?> ValueChanged { get; set; }
  [Parameter] public Expression<Func<string?>>? ValidationMessage { get; set; }
}
